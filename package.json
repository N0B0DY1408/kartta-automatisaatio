{
  "name": "kartta-automatisaatio",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "fi.karttaautomaatio.app",
    "productName": "Kartta-automaatio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "interface/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "powershell",
        "to": "powershell",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "node.exe"
        ]
      },
      {
        "from": "public-view",
        "to": "public-view",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "help",
        "to": "help",
        "filter": [
            "**/*"
        ]
    }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/N0B0DY1408/kartta-automatisaatio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/N0B0DY1408/kartta-automatisaatio/issues"
  },
  "homepage": "https://github.com/N0B0DY1408/kartta-automatisaatio#readme",
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron-builder@26.18.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  },
  "dependencies": {
    "wrangler": "^4.160.1"
  }
}
